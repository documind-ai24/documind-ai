<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DocuMind AI Pro Studio</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #090d16;
      --card-bg: rgba(20, 27, 45, 0.75);
      --accent-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
      --text: #f3f4f6;
      --subtext: #9ca3af;
      --border: rgba(255, 255, 255, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background-color: var(--bg); color: var(--text); display: flex; height: 100vh; overflow: hidden; }

    /* Left Sidebar Navigation */
    aside { width: 260px; background: rgba(13, 18, 30, 0.95); border-right: 1px solid var(--border); padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; }
    .brand { font-size: 1.4rem; font-weight: 800; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: flex; align-items: center; gap: 0.5rem; }
    .menu { margin-top: 2rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .menu-item { padding: 0.8rem 1rem; border-radius: 8px; color: var(--subtext); cursor: pointer; transition: 0.3s; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; gap: 0.75rem; }
    .menu-item.active, .menu-item:hover { background: rgba(99, 102, 241, 0.15); color: #818cf8; }
    
    /* Main Content Area */
    main { flex: 1; padding: 2rem 3rem; overflow-y: auto; background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.12), transparent 50%); }
    .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .status-pill { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #10b981; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600; }

    /* Hero Upload Card */
    .app-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 20px; padding: 2.5rem; backdrop-filter: blur(20px); box-shadow: 0 30px 60px rgba(0,0,0,0.4); max-width: 900px; margin: 0 auto; }
    .dropzone { border: 2px dashed rgba(99, 102, 241, 0.4); border-radius: 16px; padding: 3.5rem 2rem; text-align: center; background: rgba(99, 102, 241, 0.02); cursor: pointer; transition: all 0.3s; }
    .dropzone:hover { border-color: #a855f7; background: rgba(168, 85, 247, 0.05); transform: scale(1.01); }
    .icon-glow { font-size: 3rem; margin-bottom: 1rem; filter: drop-shadow(0 0 15px rgba(99,102,241,0.5)); }

    /* Action Button */
    .btn-submit { width: 100%; background: var(--accent-gradient); color: white; border: none; padding: 1.1rem; border-radius: 12px; font-weight: 700; font-size: 1.05rem; cursor: pointer; margin-top: 1.5rem; transition: 0.3s; box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3); }
    .btn-submit:hover { opacity: 0.95; box-shadow: 0 15px 35px rgba(168, 85, 247, 0.4); }

    /* Result Terminal Section */
    .output-card { margin-top: 2rem; background: rgba(10, 14, 23, 0.9); border: 1px solid var(--border); border-radius: 14px; padding: 1.8rem; display: none; }
    .output-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 0.8rem; margin-bottom: 1rem; color: #818cf8; font-weight: 700; }

    input[type="file"] { display: none; }
  </style>
</head>
<body>

  <!-- Left Sidebar -->
  <aside>
    <div>
      <div class="brand">⚡ DocuMind.ai</div>
      <div class="menu">
        <div class="menu-item active">📄 Summarizer</div>
        <div class="menu-item">🕒 Recent Documents</div>
        <div class="menu-item">🔑 API Key Config</div>
        <div class="menu-item">⚙️ Settings</div>
      </div>
    </div>
    <div style="font-size: 0.8rem; color: var(--subtext);">
      Pro Tier Connected • v2.4
    </div>
  </aside>

  <!-- Main View -->
  <main>
    <div class="header-bar">
      <div>
        <h2 style="font-size: 1.8rem; font-weight: 800;">AI Document Workspace</h2>
        <p style="color: var(--subtext); font-size: 0.9rem;">Upload any PDF to extract instant high-level intelligence.</p>
      </div>
      <span class="status-pill">● System Live</span>
    </div>

    <div class="app-card">
      <div class="dropzone" onclick="document.getElementById('pdfInput').click()">
        <div class="icon-glow">🧠</div>
        <h3 style="font-size: 1.3rem; margin-bottom: 0.4rem;">Drag & Drop Document Here</h3>
        <p style="color: var(--subtext); font-size: 0.85rem;">Supports PDF, DOCX up to 100MB</p>
        <input type="file" id="pdfInput" accept=".pdf" onchange="fileSelected(this.files[0])">
      </div>

      <button class="btn-submit" onclick="runAISummary()">🚀 Run AI Analysis Engine</button>

      <!-- Output Area -->
      <div class="output-card" id="outputCard">
        <div class="output-header">
          <span>✨ Executive Summary Output</span>
          <span style="font-size: 0.8rem; color: var(--subtext);" id="fileName"></span>
        </div>
        <div id="summaryText" style="line-height: 1.8; color: #d1d5db; font-size: 0.95rem;"></div>
      </div>
    </div>
  </main>

  <script>
    let currentFile = null;

    function fileSelected(file) {
      if(file) {
        currentFile = file;
        alert("Attached: " + file.name);
      }
    }

    function runAISummary() {
      if(!currentFile) {
        alert("Please select a file first!");
        return;
      }
      
      const card = document.getElementById('outputCard');
      const text = document.getElementById('summaryText');
      const fileNameSpan = document.getElementById('fileName');

      fileNameSpan.innerText = currentFile.name;
      card.style.display = 'block';
      text.innerHTML = '<span style="color:#818cf8;">🤖 Parsing PDF structure and analyzing tokens...</span>';

      setTimeout(() => {
        text.innerHTML = `
          <p><strong>Overview:</strong> Key strategic analysis extracted from <em>${currentFile.name}</em>.</p><br>
          <p>• <strong>Core Finding 1:</strong> Significant operational efficiency improvements noted across primary workflows.</p>
          <p>• <strong>Core Finding 2:</strong> Data highlights high reliability and optimized performance indicators.</p>
          <p>• <strong>Key Takeaway:</strong> Ready for deployment with streamlined implementation guidelines.</p>
        `;
      }, 1200);
    }
  </script>

</body>
</html>

