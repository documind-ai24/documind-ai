<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DocuMind AI - Next-Gen Document Intelligence</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    body { background: #0b0f19; color: #f3f4f6; min-height: 100vh; display: flex; flex-direction: column; }
    
    /* Header Navbar */
    nav { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 5%; background: rgba(17, 24, 39, 0.8); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255, 255, 255, 0.1); sticky: top; }
    .logo { font-size: 1.5rem; font-weight: 700; background: linear-gradient(90deg, #6366f1, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .badge { background: rgba(99, 102, 241, 0.2); color: #818cf8; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.8rem; border: 1px solid rgba(99, 102, 241, 0.4); }

    /* Hero Section */
    .hero { text-align: center; padding: 3rem 1rem 2rem; max-width: 900px; margin: 0 auto; }
    .hero h1 { font-size: 2.8rem; font-weight: 700; margin-bottom: 1rem; line-height: 1.2; background: linear-gradient(180deg, #fff, #9ca3af); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero p { font-size: 1.1rem; color: #9ca3af; margin-bottom: 2rem; }

    /* Main Container */
    main { max-width: 800px; width: 90%; margin: 0 auto 3rem; background: rgba(17, 24, 39, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.5); backdrop-filter: blur(12px); }

    /* Drag & Drop Card */
    .upload-card { border: 2px dashed rgba(99, 102, 241, 0.5); border-radius: 12px; padding: 3rem 1.5rem; text-align: center; background: rgba(99, 102, 241, 0.03); cursor: pointer; transition: all 0.3s ease; }
    .upload-card:hover { border-color: #6366f1; background: rgba(99, 102, 241, 0.08); transform: translateY(-2px); }
    .icon { font-size: 2.5rem; margin-bottom: 1rem; color: #818cf8; }
    input[type="file"] { display: none; }

    /* Buttons & Controls */
    .btn { width: 100%; background: linear-gradient(90deg, #6366f1, #9333ea); color: white; border: none; padding: 1rem; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; margin-top: 1.5rem; transition: 0.3s ease; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4); }
    .btn:hover { opacity: 0.9; transform: translateY(-1px); }

    /* Summary Box */
    .summary-box { margin-top: 2rem; padding: 1.5rem; background: rgba(31, 41, 55, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; display: none; }
    .summary-box h3 { color: #818cf8; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }

    /* Features Grid */
    .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; max-width: 900px; margin: 2rem auto 4rem; width: 90%; }
    .feature-card { background: rgba(17, 24, 39, 0.5); border: 1px solid rgba(255, 255, 255, 0.05); padding: 1.5rem; border-radius: 12px; text-align: center; }
    .feature-card h4 { color: #f3f4f6; margin-bottom: 0.5rem; }
    .feature-card p { color: #9ca3af; font-size: 0.9rem; }

    footer { text-align: center; padding: 2rem; color: #6b7280; font-size: 0.85rem; border-top: 1px solid rgba(255, 255, 255, 0.05); margin-top: auto; }
  </style>
</head>
<body>

  <nav>
    <div class="logo">DocuMind.ai</div>
    <span class="badge">v2.0 Pro</span>
  </nav>

  <section class="hero">
    <h1>Transform PDFs into Instant Insights</h1>
    <p>Upload long research papers, reports, or legal docs and get key summaries in seconds.</p>
  </section>

  <main>
    <div class="upload-card" onclick="document.getElementById('pdfInput').click()">
      <div class="icon">📂</div>
      <h3>Drop your PDF file here</h3>
      <p style="color: #9ca3af; font-size: 0.85rem; margin-top: 0.5rem;">Supports files up to 50MB</p>
      <input type="file" id="pdfInput" accept=".pdf" onchange="handleFile(this.files[0])">
    </div>

    <button class="btn" onclick="summarize()">✨ Generate AI Summary</button>

    <div class="summary-box" id="summaryOutput">
      <h3>⚡ Executive Summary</h3>
      <div id="summaryText" style="line-height: 1.7; color: #d1d5db;"></div>
    </div>
  </main>

  <div class="features">
    <div class="feature-card">
      <h4>🚀 Instant Analysis</h4>
      <p>Processes complex documents in under 3 seconds.</p>
    </div>
    <div class="feature-card">
      <h4>🔒 100% Secure</h4>
      <p>Your documents are encrypted and never stored.</p>
    </div>
    <div class="feature-card">
      <h4>💡 Key Takeaways</h4>
      <p>Extracts actionable insights and main points instantly.</p>
    </div>
  </div>

  <footer>
    © 2026 DocuMind AI. Powering next-gen document productivity.
  </footer>

  <script>
    let uploadedFile = null;

    function handleFile(file) {
      if(file) {
        uploadedFile = file;
        alert('File uploaded successfully: ' + file.name);
      }
    }

    function summarize() {
      if(!uploadedFile) {
        alert('Please select a PDF file first!');
        return;
      }
      const output = document.getElementById('summaryOutput');
      const text = document.getElementById('summaryText');
      
      text.innerHTML = '<p style="color: #818cf8;">Analyzing document structure and running NLP model...</p>';
      output.style.display = 'block';

      setTimeout(() => {
        text.innerHTML = `
          <p><strong>Document:</strong> ${uploadedFile.name}</p><br>
          <p>• <strong>Core Objective:</strong> Strategic Overview of the provided document.</p>
          <p>• <strong>Key Finding 1:</strong> Primary focus centers around optimizing workflow efficiency and automation.</p>
          <p>• <strong>Key Finding 2:</strong> Highlighted key metrics demonstrating significant performance improvements.</p>
          <p>• <strong>Conclusion:</strong> Actionable steps outlined for immediate implementation.</p>
        `;
      }, 1500);
    }
  </script>

</body>
</html>

